# ==============================================================================
# L.E.O. Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys and secrets.
# ==============================================================================

# Groq Cloud API Key (Get yours at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2048

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Spotify Developer API Credentials (Optional - https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Server & UI Settings
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
DEBUG_MODE=False

# Neural Voice Settings
TTS_VOICE=en-US-AndrewNeural
TTS_RATE=+5%
